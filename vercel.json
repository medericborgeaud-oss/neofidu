{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "installCommand": "npm install --legacy-peer-deps",
  "regions": ["fra1"],
  "crons": [
    {
      "path": "/api/cron/zefix-backfill?canton=VD",
      "schedule": "0 5 * * 1"
    },
    {
      "path": "/api/cron/zefix-backfill?canton=GE",
      "schedule": "0 5 * * 2"
    },
    {
      "path": "/api/cron/zefix-backfill?canton=VS",
      "schedule": "0 5 * * 3"
    },
    {
      "path": "/api/cron/zefix-backfill?canton=FR",
      "schedule": "0 5 * * 4"
    },
    {
      "path": "/api/cron/zefix-backfill?canton=NE",
      "schedule": "0 5 * * 5"
    },
    {
      "path": "/api/cron/zefix-backfill?canton=JU",
      "schedule": "0 5 * * 6"
    }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate, proxy-revalidate, max-age=0"
        },
        {
          "key": "Pragma",
          "value": "no-cache"
        },
        {
          "key": "Expires",
          "value": "0"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/guide",
      "destination": "/guide/deductions-fiscales",
      "permanent": true
    },
    {
      "source": "/gerance-immobiliere",
      "destination": "/entreprises",
      "permanent": true
    },
    {
      "source": "/simulateur-retraite",
      "destination": "/simulateur/retraite",
      "permanent": true
    },
    {
      "source": "/simulateur/simulateur-retraite",
      "destination": "/simulateur/retraite",
      "permanent": true
    },
    {
      "source": "/simulateur-impots",
      "destination": "/simulateur/impots",
      "permanent": true
    },
    {
      "source": "/simulateur-salaire",
      "destination": "/simulateur/salaire-net",
      "permanent": true
    },
    {
      "source": "/cantons/vd",
      "destination": "/cantons/vaud",
      "permanent": true
    },
    {
      "source": "/en/cantons/vd",
      "destination": "/en/cantons/vaud",
      "permanent": true
    },
    {
      "source": "/cantons/ge",
      "destination": "/cantons/geneve",
      "permanent": true
    },
    {
      "source": "/en/cantons/ge",
      "destination": "/en/cantons/geneve",
      "permanent": true
    },
    {
      "source": "/cantons/vs",
      "destination": "/cantons/valais",
      "permanent": true
    },
    {
      "source": "/en/cantons/vs",
      "destination": "/en/cantons/valais",
      "permanent": true
    },
    {
      "source": "/cantons/fr",
      "destination": "/cantons/fribourg",
      "permanent": true
    },
    {
      "source": "/en/cantons/fr",
      "destination": "/en/cantons/fribourg",
      "permanent": true
    },
    {
      "source": "/cantons/ne",
      "destination": "/cantons/neuchatel",
      "permanent": true
    },
    {
      "source": "/en/cantons/ne",
      "destination": "/en/cantons/neuchatel",
      "permanent": true
    },
    {
      "source": "/cantons/ju",
      "destination": "/cantons/jura",
      "permanent": true
    },
    {
      "source": "/en/cantons/ju",
      "destination": "/en/cantons/jura",
      "permanent": true
    },
    {
      "source": "/expats",
      "destination": "/en/expats",
      "permanent": true
    },
    {
      "source": "/blog/carf-2026-fin-secret-crypto-suisse",
      "destination": "/blog/echange-automatique-crypto-suisse-2026-fin-anonymat",
      "permanent": true
    },
    {
      "source": "/blog/expatries-suisse-fiscalite",
      "destination": "/blog/first-tax-return-switzerland-expat-guide",
      "permanent": true
    },
    {
      "source": "/blog/fiscalite-impots-suisse",
      "destination": "/blog/declaration-impots-2025-guide-complet",
      "permanent": true
    },
    {
      "source": "/blog/immobilier",
      "destination": "/blog/hypotheque-suisse-fonctionnement-specificites",
      "permanent": true
    },
    {
      "source": "/blog/premiere-declaration-impots-suisse-guide",
      "destination": "/blog/comment-remplir-declaration-impot-en-ligne-guide",
      "permanent": true
    }
  ]
}
